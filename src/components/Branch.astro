---
interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;

type Point = readonly [number, number];
const P: readonly [Point, Point, Point, Point] = [[290, 756], [76, 722], [-8, 424], [120, 22]];
const r = (value: number) => Math.round(value * 10) / 10;

const at = (t: number) => {
  const u = 1 - t;
  const a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
  return [
    a * P[0][0] + b * P[1][0] + c * P[2][0] + d * P[3][0],
    a * P[0][1] + b * P[1][1] + c * P[2][1] + d * P[3][1],
  ] as const;
};

const heading = (t: number) => {
  const u = 1 - t;
  const dx = 3 * u * u * (P[1][0] - P[0][0]) + 6 * u * t * (P[2][0] - P[1][0]) + 3 * t * t * (P[3][0] - P[2][0]);
  const dy = 3 * u * u * (P[1][1] - P[0][1]) + 6 * u * t * (P[2][1] - P[1][1]) + 3 * t * t * (P[3][1] - P[2][1]);
  return (Math.atan2(dy, dx) * 180) / Math.PI;
};

const leafPath = (L: number, W: number) =>
  `M0 0C${r(L * 0.22)} ${r(-W * 1.05)} ${r(L * 0.68)} ${r(-W * 0.85)} ${r(L)} 0C${r(L * 0.68)} ${r(W * 0.85)} ${r(L * 0.22)} ${r(W * 1.05)} 0 0Z`;

const veinPath = (L: number, W: number) => {
  let d = `M0 0L${r(L * 0.9)} 0`;
  for (const v of [0.2, 0.38, 0.56, 0.72]) {
    const reach = W * (0.74 - v * 0.48);
    d += `M${r(L * v)} 0L${r(L * (v + 0.15))} ${r(-reach)}M${r(L * v)} 0L${r(L * (v + 0.15))} ${r(reach)}`;
  }
  return d;
};

const COUNT = 11;
const leaves = Array.from({ length: COUNT }, (_, k) => {
  const t = 0.1 + (k / (COUNT - 1)) * 0.86;
  const [x, y] = at(t);
  const angle = heading(t);
  const size = 42 + 46 * Math.sin(Math.PI * Math.min(1, t * 0.92 + 0.06));
  return ([-1, 1] as const).map((s) => {
    const L = size * (s < 0 ? 1 : 0.9);
    const W = L * 0.36;
    return {
      x: r(x),
      y: r(y),
      rotate: r(angle + s * (34 + 10 * (1 - t))),
      shape: leafPath(L, W),
      veins: veinPath(L, W),
    };
  });
}).flat();

const [tipX, tipY] = at(0.985);
const tipL = 58;
const stem = `M${P[0].join(' ')}C${P[1].join(' ')} ${P[2].join(' ')} ${P[3].join(' ')}`;
---

<svg class:list={['branch', `branch--${side}`]} data-branch viewBox="0 0 300 790" aria-hidden="true" focusable="false">
  <g transform={side === 'right' ? 'matrix(-1 0 0 1 300 0)' : undefined}>
    <path class="stem" data-stem pathLength="1" d={stem}></path>
    {leaves.map((leaf) => (
      <g transform={`translate(${leaf.x} ${leaf.y}) rotate(${leaf.rotate})`}>
        <g data-leaf>
          <path class="leaf" d={leaf.shape}></path>
          <path class="vein" d={leaf.veins}></path>
        </g>
      </g>
    ))}
    <g transform={`translate(${r(tipX)} ${r(tipY)}) rotate(${r(heading(0.985))})`}>
      <g data-leaf>
        <path class="leaf" d={leafPath(tipL, tipL * 0.36)}></path>
        <path class="vein" d={veinPath(tipL, tipL * 0.36)}></path>
      </g>
    </g>
  </g>
</svg>

<style>
  .branch {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }

  .stem {
    fill: none;
    stroke: var(--cocoa);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .leaf {
    fill: var(--leaf);
    stroke: var(--cocoa);
    stroke-width: 1.15;
    stroke-linejoin: round;
  }

  .vein {
    fill: none;
    stroke: var(--cocoa);
    stroke-width: 0.7;
    stroke-opacity: 0.6;
    stroke-linecap: round;
  }
</style>
