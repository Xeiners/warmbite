---
import Branch from './Branch.astro';
import Drip from './Drip.astro';
import Heart from './Heart.astro';
import PastryArt from './PastryArt.astro';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';
import type { PastryKind } from '../lib/pastry';

interface Props {
  lang: Lang;
}

const t = ui[Astro.props.lang].hero;
const lines = ['warm', 'bite'];
const treats: PastryKind[] = ['donut', 'tiramisu', 'beignet', 'cake'];
---

<section class="hero" id="top" data-hero>
  <Drip band="hero" class="hero__drip" />

  <div class="hero__wreath" data-intro>
    <Branch side="left" />
    <Branch side="right" />
  </div>

  <div class="hero__inner" data-intro data-hero-inner>
    <h1 class="wordmark">
      <span class="sr-only">{t.heading}</span>
      <span class="wordmark__art" aria-hidden="true">
        <span class="whisk" data-whisk>
          <svg viewBox="0 0 150 170" focusable="false">
            <g fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" transform="rotate(33 66 90)">
              <path d="M66 104C30 80 26 24 66 8c40 16 36 72 0 96Z"></path>
              <path d="M66 104C43 80 40 26 66 8c26 18 23 72 0 96Z"></path>
              <path d="M66 104C57 80 56 28 66 8c10 20 9 72 0 96Z"></path>
            </g>
            <g transform="rotate(33 66 90)">
              <rect x="59" y="102" width="14" height="13" rx="3" fill="currentColor"></rect>
              <rect x="61" y="115" width="10" height="46" rx="5" fill="currentColor"></rect>
            </g>
            <path d="M28 150c14 12 40 12 62-12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" transform="translate(32 -8)"></path>
          </svg>
          <Heart class="whisk__heart" />
        </span>
        {treats.map((kind, index) => (
          <span class:list={['treat', `treat--${index + 1}`]} data-treat>
            <span class="treat__float"><PastryArt kind={kind} idPrefix="hero" /></span>
          </span>
        ))}
        {lines.map((word) => (
          <span class="wordmark__line">
            {[...word].map((letter) => <span class="ch" data-ch>{letter}</span>)}
          </span>
        ))}
        <span class="wordmark__heart" data-wordheart><Heart /></span>
      </span>
    </h1>

    <div class="rule">
      <span class="rule__line" data-rule-line></span>
      <span class="rule__heart" data-rule-heart><Heart /></span>
      <span class="rule__line rule__line--right" data-rule-line></span>
    </div>

    <p class="hero__tagline" data-hero-fade>{site.tagline}</p>
    <p class="hero__lead" data-hero-fade>{t.lead}</p>

    <div class="hero__actions" data-hero-fade>
      <a class="btn" href="#creations">{t.creations}</a>
      <a class="btn btn--ghost" href={site.phoneHref}>{t.call.replace('{phone}', site.phoneDisplay)}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    --wm: min(22vw, 23svh);
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(188px, 25svh, 250px) var(--gutter) clamp(32px, 6svh, 64px);
    overflow: clip;
    background: repeating-linear-gradient(90deg, var(--petal) 0 70px, var(--blush) 70px 140px);
    text-align: center;
  }

  /* Bandeau présent dès le premier rendu : seules les coulures s'animent. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: clamp(66px, 5.5vw, 84px);
    background: var(--ganache);
  }

  .hero :global(.hero__drip) {
    top: 0;
    z-index: 1;
  }

  .hero__wreath :global(.branch) {
    bottom: 1.5svh;
    width: calc(var(--wm) * 1.42);
    height: calc(var(--wm) * 3.74);
  }

  .hero__wreath :global(.branch--left) {
    right: calc(50% + var(--wm) * 0.95);
  }

  .hero__wreath :global(.branch--right) {
    left: calc(50% + var(--wm) * 0.95);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    will-change: transform;
    display: flex;
    max-width: 100%;
    flex-direction: column;
    align-items: center;
  }

  .wordmark {
    position: relative;
    font-size: var(--wm);
    line-height: 0.86;
    color: var(--cocoa);
  }

  .wordmark__art {
    position: relative;
    display: block;
  }

  .wordmark__line {
    display: block;
    clip-path: inset(-14% -14% -5% -14%);
    white-space: nowrap;
  }

  .ch {
    display: inline-block;
  }

  .whisk {
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 0.42em;
    margin-bottom: -0.05em;
    margin-left: -0.21em;
    color: var(--cocoa);
  }

  .whisk svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .whisk :global(.whisk__heart) {
    position: absolute;
    right: -2%;
    bottom: 26%;
    width: 26%;
  }

  /* Par défaut, deux pâtisseries de part et d'autre du fouet. */
  .treat {
    position: absolute;
    bottom: calc(100% + 0.04em);
    display: block;
    width: 0.56em;
    line-height: 0;
  }

  .treat :global(.pastry) {
    width: 100%;
  }

  .treat--1 {
    --tilt: -14deg;
    --float: 5.2s;
    --delay: 0s;
    left: calc(50% - 1.34em);
  }

  .treat--2 {
    --tilt: 9deg;
    --float: 6.4s;
    --delay: -2.1s;
    left: calc(50% + 0.78em);
  }

  .treat--3 {
    --tilt: 11deg;
    --float: 5.8s;
    --delay: -3.6s;
    display: none;
  }

  .treat--4 {
    --tilt: -8deg;
    --float: 7s;
    --delay: -1.2s;
    display: none;
  }

  .treat__float {
    display: block;
    transform: rotate(var(--tilt));
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .treat__float {
      animation: treat-float var(--float) var(--delay) ease-in-out infinite alternate;
    }
  }

  /* En em et non en % : une transformation en % ne peut pas tourner sur la carte graphique. */
  @keyframes treat-float {
    to {
      transform: translateY(-0.06em) rotate(calc(var(--tilt) + 6deg));
    }
  }

  /* Petit téléphone : resserrées autour du fouet, à l'écart des longues coulures. */
  @media (max-width: 720px) and (max-height: 700px) {
    .treat {
      width: 0.42em;
    }

    .treat--1 {
      left: calc(50% - 0.93em);
    }

    .treat--2 {
      left: calc(50% + 0.51em);
    }
  }

  /* Écran moyen en paysage : dans les coins bas, sous la courbe de la couronne. */
  @media (min-width: 721px) and (min-aspect-ratio: 11/10) {
    .treat {
      top: 2.25em;
      bottom: auto;
    }

    .treat--1 {
      left: max(calc(50% - 50vw + 8px), calc(50% - 2.85em));
    }

    .treat--2 {
      left: min(calc(50% + 50vw - 8px - 0.56em), calc(50% + 2.29em));
    }
  }

  /* Écran large : quatre pâtisseries à l'extérieur de la couronne. */
  @media (min-width: 1100px) and (min-aspect-ratio: 3/2) {
    .treat {
      bottom: auto;
      width: 0.66em;
    }

    .treat--1 {
      top: 0.55em;
      left: calc(50% - 3.25em);
    }

    .treat--2 {
      top: 0.68em;
      left: calc(50% + 2.62em);
    }

    .treat--3 {
      top: 1.72em;
      left: calc(50% - 3.02em);
      display: block;
    }

    .treat--4 {
      top: 1.6em;
      left: calc(50% + 2.4em);
      display: block;
    }
  }

  .wordmark__heart {
    position: absolute;
    top: 57%;
    left: calc(50% + 1.08em);
    display: block;
    width: 0.22em;
    line-height: 0;
    transform-origin: 50% 80%;
  }

  .wordmark__heart :global(.heart) {
    width: 100%;
    transform: rotate(14deg);
  }

  .rule {
    display: flex;
    width: min(calc(var(--wm) * 2.5), 100%);
    align-items: center;
    gap: 14px;
    margin-top: clamp(14px, 2.4svh, 26px);
  }

  .rule__line {
    height: 1.5px;
    flex: 1;
    background: var(--cocoa);
    transform-origin: right;
  }

  .rule__line--right {
    transform-origin: left;
  }

  .rule__heart {
    display: block;
    width: 20px;
    line-height: 0;
  }

  .rule__heart :global(.heart) {
    width: 100%;
  }

  .hero__tagline {
    margin-top: 10px;
    font-family: var(--font-accent);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.875rem);
    font-style: italic;
    line-height: 1.25;
  }

  .hero__lead {
    max-width: 30em;
    margin-top: 8px;
    color: var(--cocoa-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(16px, 3svh, 28px);
  }

  @media (max-width: 720px) {
    .hero {
      --wm: min(28.5vw, 21svh);
      padding-top: clamp(170px, 24svh, 210px);
    }

    .hero__wreath :global(.branch) {
      opacity: 0.55;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__actions {
      width: min(100%, 320px);
    }
  }
</style>
