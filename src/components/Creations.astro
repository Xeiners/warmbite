---
import Arches from './Arches.astro';
import Drip from './Drip.astro';
import PastryArt from './PastryArt.astro';
import { creations } from '../data/creations';
import { site } from '../data/site';
import videos from '../data/videos.json';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].creations;
const clips: Record<string, { duration: number }> = videos;
const domeRings = [1, 2, 3, 4].map((i) => {
  const rx = 720 + i * 46;
  const ry = 360 + i * 22;
  return `M${720 - rx} 420A${rx} ${ry} 0 0 1 ${720 + rx} 420`;
});
---

<section
  class="creations"
  id="creations"
  aria-labelledby="creations-title"
  data-carousel
  data-label-pause={t.pause}
  data-label-play={t.play}
  data-label-position={t.position}
>
  <div class="dome" aria-hidden="true">
    <svg class="dome__layer" data-dome-rings viewBox="0 0 1440 420" focusable="false">
      {domeRings.map((d) => <path class="dome__ring" d={d}></path>)}
    </svg>
    <svg class="dome__layer" data-dome viewBox="0 0 1440 420" focusable="false">
      <path class="dome__fill" d="M0 420A720 360 0 0 1 1440 420Z"></path>
    </svg>
  </div>

  <div class="container creations__head">
    <p class="eyebrow" data-reveal-dome>{t.eyebrow}</p>
    <h2 class="section-title" id="creations-title" data-reveal-dome>{t.title}</h2>
  </div>

  <div class="carousel" role="group" aria-roledescription={t.roleCarousel} aria-label={t.carousel}>
    <div class="stage" data-stage>
      <div class="stage__arches"><Arches inner={150} gap={22} rings={4} /></div>
      <ul class="track" data-track>
        {creations.map((creation, index) => {
          const clip = clips[creation.slug];
          const name = creation.name[lang];
          const position = t.position
            .replace('{n}', String(index + 1))
            .replace('{total}', String(creations.length))
            .replace('{name}', name);
          return (
            <li class="slide" data-slide aria-roledescription={t.roleSlide} aria-label={position}>
              <div class="slide__frame">
                {clip ? (
                  <video
                    class="slide__video"
                    data-video
                    muted
                    playsinline
                    preload="none"
                    width="720"
                    height="1280"
                    poster={`/videos/${creation.slug}.webp`}
                    aria-label={t.video.replace('{name}', name)}
                  >
                    <source src={`/videos/${creation.slug}.webm`} type="video/webm" />
                    <source src={`/videos/${creation.slug}.mp4`} type="video/mp4" />
                  </video>
                ) : (
                  <div class="slide__art"><PastryArt kind={creation.art} /></div>
                )}
                <span class="slide__dim" data-dim></span>
              </div>
            </li>
          );
        })}
      </ul>

      <button class="nav nav--prev" type="button" data-prev aria-label={t.previous}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <button class="nav nav--next" type="button" data-next aria-label={t.next}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>

    <div class="captions">
      {creations.map((creation) => (
        <div class="caption" data-caption>
          <h3 class="caption__name">{creation.name[lang]} <span class="caption__price">{creation.price}</span></h3>
          <p class="caption__note">{creation.note[lang]}</p>
          <a class="caption__link" href={creation.tiktok ?? site.tiktokUrl} target="_blank" rel="noopener">
            {t.tiktok} <span aria-hidden="true">↗</span>
          </a>
        </div>
      ))}
    </div>

    <div class="controls" data-controls>
      <div class="segments">
        {creations.map((creation, index) => (
          <button class="seg" type="button" data-seg aria-label={t.goTo.replace('{name}', creation.name[lang])} aria-current={index === 0 ? 'true' : 'false'}>
            <span class="seg__rail"><span class="seg__fill" data-fill></span></span>
          </button>
        ))}
      </div>

      <button class="round" type="button" data-toggle aria-label={t.pause}>
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6v12M15 6v12"></path></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5l11 7-11 7z"></path></svg>
      </button>
    </div>

    <p class="sr-only" data-live aria-live="off" aria-atomic="true"></p>
  </div>

  <Drip band="flush" mirror class="creations__drip" />
</section>

<style>
  .creations {
    --frame-h: clamp(420px, min(68svh, 120vw), 640px);
    --frame-w: calc(var(--frame-h) * 0.5625);
    position: relative;
    z-index: 2;
    padding-block: clamp(16px, 3vw, 40px) clamp(56px, 7vw, 96px);
    overflow-x: clip;
    background: var(--ganache);
    color: var(--petal);
  }

  .dome {
    position: absolute;
    inset-inline: 0;
    bottom: calc(100% - 1px);
    z-index: -1;
    aspect-ratio: 1440 / 420;
    pointer-events: none;
  }

  /* Deux calques déplacés par la carte graphique, sans jamais redessiner le SVG. */
  .dome__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    will-change: transform, opacity;
  }

  .dome__fill {
    fill: var(--ganache);
  }

  .dome__ring {
    fill: none;
    stroke: var(--cocoa);
    stroke-width: 2.5;
  }

  /* Le titre remonte à l'intérieur du dôme. */
  .creations__head {
    position: relative;
    margin-top: calc(clamp(40px, 16vw, 290px) * -1);
    text-align: center;
  }

  .creations__head .eyebrow {
    color: var(--on-ganache-muted);
    margin-bottom: 14px;
  }

  [data-reveal-dome] {
    will-change: transform, opacity;
  }

  .carousel {
    margin-top: calc(var(--frame-w) * 0.34 + clamp(24px, 3vw, 40px));
  }

  .stage {
    --nav-size: clamp(44px, 5vw, 64px);
    position: relative;
    touch-action: pan-y;
    user-select: none;
  }

  :global(html.js) .stage {
    cursor: grab;
  }

  :global(html.js) .stage:global(.is-dragging) {
    cursor: grabbing;
  }

  /* Flèches posées juste à l'extérieur des cartes latérales, ou sur leur bord si la place manque. */
  .nav {
    --nav-offset: calc(var(--frame-w) * 1.42 + 16px + var(--nav-size));
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: var(--nav-size);
    height: var(--nav-size);
    place-items: center;
    border-radius: 50%;
    background: var(--rose);
    color: var(--ganache);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.3);
    translate: 0 -50%;
    transition: background-color 0.3s, scale 0.35s var(--ease-out);
  }

  .nav--prev {
    left: max(8px, calc(50% - var(--nav-offset)));
  }

  .nav--next {
    right: max(8px, calc(50% - var(--nav-offset)));
  }

  .nav svg {
    width: 42%;
    height: 42%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.35s var(--ease-out);
  }

  @media (hover: hover) {
    .nav:hover {
      background: var(--heart);
      scale: 1.08;
    }

    .nav--prev:hover svg {
      translate: -3px 0;
    }

    .nav--next:hover svg {
      translate: 3px 0;
    }
  }

  .nav:active {
    scale: 0.94;
  }

  .stage__arches {
    position: absolute;
    top: calc(var(--frame-w) * -0.34);
    inset-inline: 0;
    width: calc(var(--frame-w) * 1.76);
    margin-inline: auto;
    color: var(--heart);
    opacity: 0.55;
    will-change: transform, opacity;
    -webkit-mask-image: linear-gradient(#000 52%, transparent 78%);
    mask-image: linear-gradient(#000 52%, transparent 78%);
  }

  .track {
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .slide {
    grid-area: 1 / 1;
    width: var(--frame-w);
    height: var(--frame-h);
    will-change: transform;
  }

  .slide__frame {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    overflow: hidden;
    place-items: center;
    border-radius: calc(var(--frame-w) / 2) calc(var(--frame-w) / 2) 26px 26px;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.28) 0 26px, transparent 26px 52px),
      linear-gradient(180deg, #ffe7eb, var(--rose));
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.32);
  }

  .slide__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide__art {
    display: grid;
    width: 100%;
    place-items: center;
  }

  .slide__dim {
    position: absolute;
    inset: 0;
    background: var(--ganache);
    opacity: 0;
    pointer-events: none;
  }

  .captions {
    display: grid;
    margin-top: clamp(26px, 3.4vw, 40px);
    padding-inline: var(--gutter);
    text-align: center;
  }

  .caption {
    grid-area: 1 / 1;
  }

  .caption__name {
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
    line-height: 1.1;
  }

  .caption__price {
    margin-left: 0.3em;
    color: var(--heart);
  }

  .caption__note {
    margin-top: 6px;
    color: var(--on-ganache-muted);
  }

  .caption__link {
    display: inline-block;
    padding-block: 10px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
  }

  .round {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px rgb(246 201 208 / 0.5);
    color: var(--petal);
    transition: background-color 0.3s, color 0.3s;
  }

  .round svg {
    grid-area: 1 / 1;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) {
    .round:hover {
      background: var(--rose);
      color: var(--ganache);
    }
  }

  .icon-play {
    visibility: hidden;
  }

  .round[data-paused] .icon-play {
    visibility: visible;
  }

  .round[data-paused] .icon-pause {
    visibility: hidden;
  }

  .segments {
    display: flex;
    gap: 6px;
    margin-inline: 6px;
  }

  .seg {
    width: clamp(30px, 6vw, 48px);
    padding-block: 21px;
  }

  .seg__rail {
    display: block;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(246 201 208 / 0.28);
  }

  .seg__fill {
    display: block;
    height: 100%;
    background: var(--heart);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  /* Sans JavaScript : simple défilement horizontal. */
  :global(html:not(.js)) .track {
    display: flex;
    gap: 16px;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  :global(html:not(.js)) .slide {
    flex: none;
    scroll-snap-align: center;
  }

  :global(html:not(.js)) .controls,
  :global(html:not(.js)) .nav,
  :global(html:not(.js)) .stage__arches {
    display: none;
  }

  .creations :global(.creations__drip) {
    top: calc(100% - 1px);
    z-index: 3;
  }
</style>
