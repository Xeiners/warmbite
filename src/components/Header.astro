---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';
import { languages, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].header;
---

<header class="header" data-header>
  <div class="header__bar">
    <a class="header__logo" href="#top" aria-label={t.home.replace('{name}', site.name)}>
      <Image src={logo} alt="" width={60} height={60} densities={[1, 2]} format="webp" quality={82} loading="eager" />
    </a>
    <nav class="header__nav" aria-label={t.nav}>
      <a href="#creations">{t.creations}</a>
      <a href="#carte">{t.menu}</a>
    </nav>
    <div class="header__end">
      <nav class="lang" aria-label={t.languageNav}>
        {Object.entries(languages).map(([code, item]) => (
          <a href={item.href} lang={code} hreflang={code} aria-label={item.name} aria-current={code === lang ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <a class="btn btn--rose header__cta" href="#commander">{t.order}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 9px clamp(10px, 2.4vw, 32px);
    color: var(--petal);
    transition: transform 0.55s var(--ease-out);
  }

  .header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 0 8px;
    border-radius: 999px;
    transition: background-color 0.35s, padding 0.35s var(--ease-out);
  }

  .header:global(.is-floating) .header__bar {
    padding: 6px 8px;
    background: var(--ganache);
    box-shadow: 0 10px 30px rgb(62 28 16 / 0.22);
  }

  .header:global(.is-hidden):not(:focus-within) {
    transform: translateY(-130%);
  }

  .header__logo {
    display: block;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
  }

  .header__logo img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header__nav {
    display: flex;
    gap: clamp(22px, 3vw, 44px);
    font-weight: 500;
  }

  .header__nav a {
    position: relative;
    padding: 12px 0;
  }

  .header__nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 8px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  @media (hover: hover) {
    .header__nav a:hover::after {
      transform: none;
      transform-origin: left;
    }
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 18px);
    justify-self: end;
  }

  .lang {
    display: flex;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .lang a {
    display: grid;
    min-width: 38px;
    min-height: 44px;
    place-items: center;
    opacity: 0.72;
    transition: opacity 0.3s;
  }

  .lang a[aria-current] {
    opacity: 1;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  @media (hover: hover) {
    .lang a:hover {
      opacity: 1;
    }
  }

  .header__cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }

  @media (max-width: 480px) {
    .header__bar {
      grid-template-columns: 1fr auto;
    }

    .header__nav {
      display: none;
    }
  }
</style>
